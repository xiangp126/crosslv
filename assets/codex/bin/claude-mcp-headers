#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
claude_dir="${CLAUDE_CONFIG_DIR:-${HOME:?}/.claude}"
credentials_file="$claude_dir/.credentials.json"
refresh_margin_ms=900000
refresh_lock="$claude_dir/.codex-mcp-refresh.lock"
refresh_lock_wait_sec=65
refresh_command_timeout_sec=55

if [[ "$mode" == "--list" ]]; then
    jq -er '
        [
            .mcpOAuth
            | to_entries[]
            | .value
            | select((.serverName // "") | test("^nvidia-[a-z0-9][a-z0-9-]*$"))
            | . as $entry
            | ($entry.serverName | sub("^nvidia-"; "")) as $service
            | select($entry.serverUrl == ("https://maas.prd.astra.nvidia.com/maas/" + $service + "/mcp"))
            | select(($entry.accessToken // "") != "")
            | $entry.serverName
        ]
        | unique
        | .[]
    ' "$credentials_file"
    exit 0
fi

server_name="$mode"
if [[ ! "$server_name" =~ ^nvidia-([a-z0-9][a-z0-9-]*)$ ]]; then
    echo "unsupported MCP server name: $server_name" >&2
    exit 2
fi
service_name="${BASH_REMATCH[1]}"
expected_url="https://maas.prd.astra.nvidia.com/maas/${service_name}/mcp"

# Claude can retain an old entry after a server configuration changes. Select
# the freshest usable entry whose name and URL agree; never export a token from
# a similarly named or non-MaaS endpoint.
# shellcheck disable=SC2016  # jq variables, intentionally not shell-expanded
credential_filter='
    [
        .mcpOAuth
        | to_entries[]
        | .value
        | select(.serverName == $server and .serverUrl == $url)
        | select((.accessToken // "") != "")
    ]
    | if length == 0 then error("no matching authenticated Claude MCP credential")
      else max_by(.expiresAt // 0)
      end
'

credential_expiry() {
    jq -er --arg server "$server_name" --arg url "$expected_url" \
        "$credential_filter | .expiresAt" "$credentials_file"
}

validate_expiry() {
    local value="$1"
    if [[ ! "$value" =~ ^[0-9]+$ ]]; then
        echo "invalid expiresAt for MCP server: $server_name" >&2
        return 1
    fi
}

ensure_fresh_credential() {
    local now_ms expires_at refresh_output

    now_ms=$(date +%s%3N)
    expires_at=$(credential_expiry)
    validate_expiry "$expires_at"
    (( expires_at > now_ms + refresh_margin_ms )) && return 0

    # Every configured MCP starts concurrently. One process refreshes all Claude
    # MCP credentials; the rest wait, re-read the file, and reuse that result.
    # This must be synchronous: Codex retries a rejected helper header only once
    # and only when the helper returns a different value.
    exec 9>"$refresh_lock"
    if ! flock -w "$refresh_lock_wait_sec" 9; then
        echo "timed out waiting for Claude MCP credential refresh" >&2
        return 1
    fi

    now_ms=$(date +%s%3N)
    expires_at=$(credential_expiry)
    validate_expiry "$expires_at"
    (( expires_at > now_ms + refresh_margin_ms )) && return 0

    if ! refresh_output=$(timeout "${refresh_command_timeout_sec}s" claude mcp list 2>&1); then
        echo "Claude MCP silent refresh failed; no stale token was returned" >&2
        printf '%s\n' "$refresh_output" | tail -n 20 >&2
        return 1
    fi

    now_ms=$(date +%s%3N)
    expires_at=$(credential_expiry)
    validate_expiry "$expires_at"
    if (( expires_at <= now_ms + refresh_margin_ms )); then
        echo "Claude MCP silent refresh did not produce a fresh credential for $server_name" >&2
        return 1
    fi
}

ensure_fresh_credential

jq -ce --arg server "$server_name" --arg url "$expected_url" \
    "$credential_filter | {Authorization: (\"Bearer \" + .accessToken)}" \
    "$credentials_file"
