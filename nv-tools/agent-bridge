from datetime import datetime
from pathlib import Path

UID = os.getuid()
# Local disk, short: a socket path over 108 bytes cannot be bound, and a lock
# on the NFS home outlives a crashed host (2026-10-09). /var/tmp, not /tmp:
# m-fwdev-167's systemd-tmpfiles deletes what has sat in /tmp for two days,
# and the sockets and the lock of a daemon up that long are such files. Nothing
# cleans /var/tmp, so the log here is kept in size by turn_logs().
RUN_DIR = Path(f"/var/tmp/agent-bridge-{UID}")
SOCKET = RUN_DIR / "bridge.sock"
LOG = RUN_DIR / "daemon.log"
# One socket per Codex session, named by its id: the uds: address its messages
# to Claude sessions come from and their replies go to. The same path after a
# restart, so an address handed out before one still reaches it.
REPLY_DIR = RUN_DIR / "r"
SELF = Path(__file__).resolve()
JCL = SELF.parent / "jcl"
CLAUDE_SESSIONS = Path.home() / ".claude" / "sessions"
CLAUDE_PROJECTS = Path.home() / ".claude" / "projects"
# What the user typed to get here: `jcl bridge` says so, and hints name the
# command that works there - jcl bridge has no send, being a person's
PROG = os.environ.get("AGENT_BRIDGE_PROG") or "agent-bridge"

LOG_MAX = 256 << 10       # bytes the log reaches before turn_logs() turns it over
SCAN_EVERY = 30           # seconds between looks for sessions
IDLE_EXIT = 15 * 60       # daemon leaves after this long with no Codex session and no request
CONFIRM_WAIT = 10         # seconds a send looks for its message in the recipient's transcript
SEND_TIMEOUT = 150        # a send: up to two scans (jcl, 60 s each) and the confirmation
LINE_MAX = 1_000_000      # Claude takes a same-machine message of about a million characters
RATE_LIMIT = (20, 600)    # messages per (sender, target) pair per window, in seconds
# The permission modes in which a session holds what another session sends for
# its user's approval: bypassPermissions, and plan where bypass is available
HOLDING_MODES = ("bypassPermissions", "plan")
ENVELOPE_RE = re.compile(r"<cross-session-message\s+([^>]*)>\n?(.*?)\n?</cross-session-message>", re.S)
ATTR_RE = re.compile(r'([\w-]+)="([^"]*)"')


def log(msg):
    with open(LOG, "a") as fh:
        fh.write(f"{time.strftime('%m-%d %H:%M:%S')} {msg}\n")


def turn_logs():
    """Keep the log in RUN_DIR small, nothing else cleaning /var/tmp.

    Called by the daemon alone. Past LOG_MAX, daemon.log becomes daemon.log.1
    and the daemon's own stdout and stderr move on to the new file with it: two
    files at most, the current one and the one before.
    """
    try:
        if LOG.stat().st_size > LOG_MAX:
            LOG.replace(LOG.with_name(LOG.name + ".1"))
            fd = os.open(LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
            os.dup2(fd, 1)
            os.dup2(fd, 2)
            os.close(fd)
    except OSError:
        pass


def secure_run_dir():
    """Create RUN_DIR, or refuse one that someone else could have planted."""
    RUN_DIR.mkdir(mode=0o700, exist_ok=True)
    st = os.lstat(RUN_DIR)
    if st.st_uid != UID or not os.path.isdir(RUN_DIR) or os.path.islink(RUN_DIR) or st.st_mode & 0o077:
        raise SystemExit(f"agent-bridge: {RUN_DIR} must be a 0700 directory owned by you")


def parse_envelopes(content):
    """Each cross-session message in a message's content, as dicts.

    The envelope is Claude Code's own wrapping of a peer message: SendMessage
    puts one around the text of each line it writes into an inbox, a reply to
    a Codex session included.
    """
    found = []
    for match in ENVELOPE_RE.finditer(content):
        attrs = {k: html.unescape(v) for k, v in ATTR_RE.findall(match[1])}
        found.append({"from": attrs.get("from", ""), "from_name": attrs.get("from-name", ""),
                      "text": match[2]})
    return found


def messaging_name(rec):
    """The name a Codex session is reached by: its title, as jcl shows it.

    Spaces become hyphens, as in the names Claude gives its sessions, so a name
    copied off the screen needs no quotes (2026-10-12). Untitled, the tail of
    its id: the head of a UUIDv7 is a timestamp, which two sessions started
    together share (two came up as codex-01a12630, 2026-10-10).
    """
    name = "-".join((rec.get("name") or "").split())[:60]
    return name or f"codex-{rec['session_id'][-6:]}"


def unique_names(records):
    """Codex session id -> a name no other session on the host answers to.

    A Codex session signs its messages to Claude sessions with it. One the same
    as a Claude session's would send a reply by name to that session, so the
    later one gets the tail of its id appended.
    """
    taken = {r.get("name") for r in records if r.get("agent") == "claude" and r.get("name")}
    names = {}
    for rec in sorted((r for r in records if r.get("agent") == "codex"), key=lambda r: r["session_id"]):
        name = messaging_name(rec)
        if name in taken:
            name = f"{name}-{rec['session_id'][-4:]}"
        taken.add(name)
        names[rec["session_id"]] = name
    return names


def codex_message(from_name, reply_to, text):
    """What a Codex session reads: who sent it, how to answer, then the text.

    The first line is all the bridge adds: Codex has no envelope to say who a
    message is from. The text is the sender's, untouched, and the line names
    nobody else - Peter included, who is no party to it (2026-10-12).
    """
    return (f"Message from @{from_name} - another agent. Reply with: "
            f"agent-bridge send --to {shlex.quote(reply_to)} '<your reply>'\n{text}")


def _attr(value):
    """An envelope attribute's value, escaped as parse_envelopes() unescapes it."""
    return html.escape(value, quote=False).replace('"', "&quot;")


def inbox_line(reply, from_name, text, msg_id):
    """One message as SendMessage writes it into an inbox (Claude Code 2.1.283).

    Claude Code documents its inbox socket for scripts to post into, but not
    this line: it is SendMessage's own, captured byte for byte (2026-10-12).
    `from` is where a reply goes. from-mode says prompting, which the bridge
    is: a session that bypasses permission prompts holds the message for its
    user, as it holds one from any prompting session. A closing tag in the
    text would end the envelope early, so it is escaped.
    """
    address = f"uds:{reply}"
    body = text.replace("</cross-session-message", "&lt;/cross-session-message")
    content = (f'<cross-session-message from="{_attr(address)}" from-name="{_attr(from_name)}"'
               f' from-mode="prompting">\n{body}\n</cross-session-message>')
    return json.dumps({"msgV": 1, "msg_id": msg_id, "type": "user",
                       "message": {"role": "user", "content": content},
                       "priority": "next", "from": address},
                      ensure_ascii=False, separators=(",", ":")) + "\n"


def post_to_claude(inbox, reply, from_name, text):
    """Write one message into a Claude session's inbox socket; its msg_id.

    OSError when the inbox takes no connection, the session having gone;
    ValueError for a message past what a Claude session takes.
    """
    msg_id = str(uuid.uuid4())
    line = inbox_line(reply, from_name, text, msg_id)
    if len(line) > LINE_MAX:
        raise ValueError(f"{len(line)} characters, more than the {LINE_MAX} a Claude session takes")
    with socket.socket(socket.AF_UNIX) as sock:
        sock.settimeout(10)
        sock.connect(str(inbox))
        sock.sendall(line.encode())
    return msg_id


def claude_registry(pid):
    """A Claude session's own record, ~/.claude/sessions/<pid>.json, or {}."""
    try:
        return json.loads((CLAUDE_SESSIONS / f"{pid}.json").read_text())
    except (OSError, ValueError):
        return {}


def claude_transcript(session_id):
    """A Claude session's transcript under ~/.claude/projects, or None."""
    return next(CLAUDE_PROJECTS.glob(f"*/{session_id}.jsonl"), None)


def last_permission_mode(transcript):
    """The permission mode a Claude session last recorded in its transcript, or ""."""
    try:
        with open(transcript, "rb") as fh:
            fh.seek(max(0, fh.seek(0, os.SEEK_END) - (1 << 20)))
            found = re.findall(rb'"permissionMode":"([A-Za-z]+)"', fh.read())
    except (OSError, TypeError):
        return ""
    return found[-1].decode() if found else ""


def permission_mode(rec, transcript):
    """A Claude session's permission mode: the last its transcript records, else its command line's.

    A session that has had no turn yet has recorded none; one started with
    --dangerously-skip-permissions or --permission-mode says so in its argv.
    """
    mode = last_permission_mode(transcript)
    if mode:
        return mode
    try:
        argv = Path(f"/proc/{rec.get('pid')}/cmdline").read_bytes().decode(errors="replace").split("\0")
    except OSError:
        return ""
    for n, arg in enumerate(argv):
        if arg == "--dangerously-skip-permissions":
            return "bypassPermissions"
        if arg == "--permission-mode" and n + 1 < len(argv):
            return argv[n + 1]
        if arg.startswith("--permission-mode="):
            return arg.split("=", 1)[1]
    return ""


def confirm_delivery(rec, transcript, offset, msg_id, wait=CONFIRM_WAIT):
    """Whether a Claude session took a message.

    "delivered", "busy", "waiting", "held" or "unconfirmed". Claude Code writes
    each peer message it delivers into the session's transcript with the
    sender's msg_id (origin.msg_id): an idle session at once, a busy one at its
    next tool call. Not there after `wait` seconds, the session's own status
    says why - busy, or waiting on its user - and its permission mode whether
    it holds messages for its user's approval, which it tells no address the
    bridge has (2026-10-12). An idle session that holds nothing and has not
    taken it no longer reads the line inbox_line() writes: a Claude Code
    upgrade has changed it.
    """
    needle = msg_id.encode()
    deadline = time.monotonic() + wait
    while True:
        transcript = transcript or claude_transcript(rec["session_id"])
        if transcript:
            try:
                with open(transcript, "rb") as fh:
                    fh.seek(offset)
                    if needle in fh.read():
                        return "delivered"
            except OSError:
                pass
        if time.monotonic() >= deadline:
            break
        time.sleep(0.25)
    status = claude_registry(rec.get("pid")).get("status")
    if status in ("busy", "waiting"):
        return status
    return "held" if permission_mode(rec, transcript) in HOLDING_MODES else "unconfirmed"


def reply_socket(thread):
    """The reply socket of a Codex session: where Claude sessions answer it."""
    return REPLY_DIR / f"{thread}.sock"


def codex_command():
    """(argv prefix, extra env) for the codex program, skipping the node launcher.

    The launcher probes /labhome/node_modules, an autofs miss that costs ~7 s
    (2026-10-03); bashrc runs the native program the same way.
    """
    for root in sorted(glob.glob(str(Path.home() / ".nvm/versions/node/*/lib/node_modules/@openai/codex")),
                       reverse=True):
        for native in glob.glob(f"{root}/node_modules/@openai/codex-*/vendor/*/bin/codex"):
            if os.access(native, os.X_OK):
                return [native], {"CODEX_MANAGED_BY_NPM": "1", "CODEX_MANAGED_PACKAGE_ROOT": root}
    return ["codex"], {}


def deliver_to_codex(thread, text):
    """Queue text into a Codex session; (ok, detail).

    `codex queue` returns once the queue holds it; the session starts on it
    when next idle. It needs the session to have had a first message: a
    session with no rollout yet is refused ("no rollout found").
    """
    argv, extra = codex_command()
    try:
        done = subprocess.run(argv + ["queue", "--thread", thread, "--message", text],
                              stdin=subprocess.DEVNULL, capture_output=True, text=True,
                              timeout=60, env={**os.environ, **extra})
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, f"codex queue failed: {exc}"
    if done.returncode == 0:
        # Its "Queued message <id> for thread <id>." adds nothing, and its
        # housekeeping ("WARNING: failed to clean up stale arg0 temp dirs ...")
        # was once reported as the detail of a send that had worked (2026-10-11)
        return True, "queued"
    detail = [line for line in (done.stdout + "\n" + done.stderr).splitlines()
              if line.strip() and not line.startswith("WARNING:")]
    reason = detail[-1] if detail else f"codex queue exit {done.returncode}"
    if "no rollout found" in reason:
        reason = "that Codex session has had no message yet, so it cannot be queued into"
    return False, reason


def own_view(records):
    """`jcl list --json` as the bridge needs it: each Claude session with its inbox."""
    view = []
    for rec in records:
        if rec.get("agent") == "claude":
            rec = {**rec, "inbox": claude_registry(rec.get("pid")).get("messagingSocketPath") or ""}
        view.append(rec)
    return view


def proc_started_at(pid):
    """When the process started, in epoch seconds, or None."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
        ticks = int(stat[stat.rindex(")") + 2:].split()[19])
        btime = next(int(line.split()[1]) for line in Path("/proc/stat").read_text().splitlines()
                     if line.startswith("btime "))
        return btime + ticks / os.sysconf("SC_CLK_TCK")
    except (OSError, ValueError, IndexError, StopIteration):
        return None


TURN_EVENTS = ("task_started", "task_complete", "turn_aborted")


def interrupted_at(rec):
    """When a Codex session's last turn was interrupted, while it still holds its queue.

    A Codex session whose turn was stopped with Esc takes no queued message
    until its next typed one, and runs them right after it; `codex queue`
    reports such a message queued all the same (2026-10-11, 3:9.1 sat on one
    for an hour). The newest turn event in its rollout says so. One logged
    before the process started belongs to a process since replaced, a resume,
    which holds nothing. None when it is not holding.
    """
    home = Path(rec.get("agent_home") or Path.home() / ".codex")
    path = next(home.joinpath("sessions").glob(f"*/*/*/rollout-*-{rec['session_id']}.jsonl"), None)
    try:
        with open(path, "rb") as fh:
            fh.seek(max(0, fh.seek(0, os.SEEK_END) - (2 << 20)))
            lines = fh.read().split(b"\n")
    except (OSError, TypeError):
        return None
    for raw in reversed(lines):
        if not any(f'"{event}"'.encode() in raw for event in TURN_EVENTS):
            continue
        try:
            entry = json.loads(raw)
        except ValueError:
            continue
        payload = entry.get("payload") or {}
        if entry.get("type") != "event_msg" or payload.get("type") not in TURN_EVENTS:
            continue
        if payload["type"] != "turn_aborted" or payload.get("reason") != "interrupted":
            return None
        try:
            at = datetime.fromisoformat(entry["timestamp"].replace("Z", "+00:00")).timestamp()
        except (KeyError, AttributeError, ValueError):
            return None
        started = proc_started_at(rec.get("pid"))
        return at if started is None or at >= started else None
    return None


def where_of(rec):
    """A session's tmux pane, "desktop" for Claude/Codex Desktop's own, else "-"."""
    return rec.get("target") or ("desktop" if rec.get("origin") == "desktop" else "-")


def request(msg, timeout=10.0):
    """One request to the daemon over its socket, one JSON reply back."""
    with socket.socket(socket.AF_UNIX) as sock:
        sock.settimeout(timeout)
        sock.connect(str(SOCKET))
        sock.sendall((json.dumps(msg) + "\n").encode())
        data = b""
        while not data.endswith(b"\n"):
            chunk = sock.recv(65536)
            if not chunk:
                break
            data += chunk
    return json.loads(data or b"{}")


def ensure_daemon(wait=10.0):
    """Start the daemon unless it already answers; True once it does."""
    try:
        return bool(request({"op": "ping"}, timeout=2).get("ok"))
    except (OSError, ValueError):
        pass
    secure_run_dir()
    with open(LOG, "a") as out:
        subprocess.Popen([sys.executable, str(SELF), "daemon"], stdin=subprocess.DEVNULL,
                         stdout=out, stderr=out, start_new_session=True)
    deadline = time.monotonic() + wait
    while time.monotonic() < deadline:
        time.sleep(0.3)
        try:
            if request({"op": "ping"}, timeout=2).get("ok"):
                return True
        except (OSError, ValueError):
            continue
    return False


class ReplyHandler(socketserver.StreamRequestHandler):
    """One connection to a reply socket: a Claude session answering a Codex session."""

    timeout = 30      # what Claude Code gives a connection to its own inbox

    def handle(self):
        try:
            for raw in iter(lambda: self.rfile.readline(LINE_MAX + 1), b""):
                self.server.bridge.reply_line(self.server.thread, raw)
        except OSError:
            pass


class ReplyServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    """The reply socket of one Codex session."""

    daemon_threads = True

    def __init__(self, thread, bridge):
        self.thread, self.bridge = thread, bridge
        super().__init__(str(reply_socket(thread)), ReplyHandler)


class Daemon:
    def __init__(self):
        self.replies = {}             # Codex thread id -> its ReplyServer
        self.names = {}               # Codex thread id -> the name its messages are signed with
        self.started = time.time()
        self.lock = threading.RLock()
        self.reply_lock = threading.RLock()   # binding and closing reply sockets
        self.sessions = []            # last `jcl list --json`
        self.last_activity = time.time()
        self.deliveries = queue.Queue()
        self.rate = collections.defaultdict(collections.deque)
        self.stop_event = threading.Event()
        self.scan_lock = threading.Lock()
        # Set once the first scan is done: answered before it, peers listed
        # nobody
        self.scanned = threading.Event()
        # (sender, Codex thread) -> the interruption a sender was told of, so
        # each hears once that the session holds its messages, not per message
        self.held_told = {}

    def codex_sessions(self):
        return [r for r in self.sessions if r.get("agent") == "codex" and r.get("alive")
                and r.get("kind") in ("", "interactive", None)]

    def claude_sessions(self):
        return [r for r in self.sessions if r.get("agent") == "claude" and r.get("alive")
                and r.get("kind") in ("", "interactive", None)]

    def scan(self):
        """Look for sessions; keep a reply socket for each Codex session that can take a message."""
        with self.scan_lock:
            try:
                out = subprocess.run([str(JCL), "list", "--json"], capture_output=True, text=True,
                                     timeout=60, stdin=subprocess.DEVNULL).stdout
                self.sessions = own_view(json.loads(out or "[]"))
            except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
                log(f"scan failed: {exc}")
                return
            self.names = unique_names([r for r in self.sessions if r.get("agent") == "claude"]
                                      + self.codex_sessions())
            live = {r["session_id"] for r in self.codex_sessions() if not r.get("empty")}
            with self.lock:
                kept = list(self.replies)
            for thread in kept:
                if thread not in live:
                    self.close_reply(thread)
            for thread in live:
                self.open_reply(thread)
            self.scanned.set()

    def open_reply(self, thread):
        """Bind a Codex session's reply socket unless it is bound; whether it is."""
        with self.reply_lock:
            with self.lock:
                server = self.replies.get(thread)
            if server and reply_socket(thread).exists():
                return True
            if server:          # its file removed from under it
                self.close_reply(thread)
            REPLY_DIR.mkdir(mode=0o700, exist_ok=True)
            reply_socket(thread).unlink(missing_ok=True)
            try:
                server = ReplyServer(thread, self)
            except OSError as exc:
                log(f"reply socket for codex {thread}: {exc}")
                return False
            os.chmod(reply_socket(thread), 0o600)
            threading.Thread(target=server.serve_forever, daemon=True).start()
            with self.lock:
                self.replies[thread] = server
        return True

    def close_reply(self, thread):
        with self.reply_lock:
            with self.lock:
                server = self.replies.pop(thread, None)
            if not server:
                return
            server.shutdown()
            server.server_close()
            reply_socket(thread).unlink(missing_ok=True)

    def reply_owner(self, path):
        """The live Codex session a reply socket path belongs to, or None."""
        path = Path(path)
        if path.parent != REPLY_DIR or path.suffix != ".sock":
            return None
        return path.stem if any(r["session_id"] == path.stem for r in self.codex_sessions()) else None

    def claude_name(self, address):
        """The name of the Claude session a SendMessage address reaches."""
        if not address.startswith("uds:"):
            return address      # a name already
        rec = next((r for r in self.claude_sessions() if f"uds:{r.get('inbox')}" == address), None)
        return (rec.get("name") or rec["session_id"][:8]) if rec else address

    def held_since(self, thread):
        """interrupted_at() for one of the Codex sessions last seen, else None."""
        rec = next((r for r in self.codex_sessions() if r["session_id"] == thread), None)
        return interrupted_at(rec) if rec else None

    def name_of(self, thread):
        """The name a Codex session's messages are signed with."""
        if thread in self.names:
            return self.names[thread]
        rec = next((r for r in self.codex_sessions() if r["session_id"] == thread), None)
        return messaging_name(rec) if rec else f"codex-{thread[-6:]}"

    def resolve(self, target):
        """("codex", thread id) or ("claude", a name or uds: address) for a --to.

        A --to is a session's name, its session id or the first 8 or more
        characters of it (jcl's SESSION ID column), or the uds: address a
        message came from: a Claude session's inbox, or a Codex session's reply
        socket. A Claude session named by id is reached through its own inbox,
        uds:<socket>. An id start shared by two sessions is refused rather than
        guessed: a Codex id is a UUIDv7, whose head is a timestamp, so sessions
        started within the same minute share it.
        """
        if target.startswith("uds:"):
            thread = self.reply_owner(target[4:])
            return ("codex", thread) if thread else ("claude", target)
        # A Codex title typed with its spaces, as names read before 2026-10-12
        wanted = "-".join(target.split())
        for rec in self.codex_sessions():
            thread = rec["session_id"]
            if wanted in (thread, self.names.get(thread), messaging_name(rec)):
                return "codex", thread
        hits = []
        if len(target) >= 8 and re.fullmatch(r"[0-9a-fA-F-]+", target):
            hits = [r for r in self.codex_sessions() + self.claude_sessions()
                    if r["session_id"].startswith(target.lower())]
        if len(hits) > 1:
            raise LookupError(f"{target} starts {len(hits)} session ids ("
                              + ", ".join(r["session_id"] for r in hits) + "); give more of it")
        if not hits:
            return "claude", target     # a Claude session's name
        rec = hits[0]
        if rec["agent"] == "codex":
            return "codex", rec["session_id"]
        if not rec.get("inbox"):
            raise LookupError(f"Claude session {rec['session_id']} has no inbox to deliver to")
        return "claude", f"uds:{rec['inbox']}"

    def claude_target(self, dst):
        """The live Claude session a --to names, by its inbox's uds: address or by its name."""
        for look in range(2):
            if dst.startswith("uds:"):
                hits = [r for r in self.claude_sessions() if f"uds:{r.get('inbox')}" == dst]
            else:
                hits = [r for r in self.claude_sessions() if r.get("name") == dst]
            if hits or look:
                break
            self.scan()        # a session started, or renamed, since the last look
        if not hits:
            raise LookupError(f"no session {dst!r} on this host; `agent-bridge peers` lists them")
        if len(hits) > 1:
            raise LookupError(f"{len(hits)} Claude sessions are named {dst!r}; give one's session id ("
                              + ", ".join(r["session_id"] for r in hits) + ")")
        if not hits[0].get("inbox"):
            raise LookupError(f"Claude session {dst!r} has no inbox to deliver to")
        return hits[0]

    def allowed(self, src, dst):
        count, window = RATE_LIMIT
        stamps = self.rate[(src, dst)]
        now = time.time()
        while stamps and now - stamps[0] > window:
            stamps.popleft()
        if len(stamps) >= count:
            return False
        stamps.append(now)
        return True

    def handle(self, req):
        self.last_activity = time.time()
        op = req.get("op")
        if op == "ping":
            return {"ok": True}
        if op == "send":
            return self.send(req)
        if op == "scan":
            self.scan()
            return {"ok": True}
        if op == "status":
            with self.lock:
                relayed = set(self.replies)
            rows = [{"thread": r["session_id"], "name": self.name_of(r["session_id"]), "where": where_of(r)}
                    for r in self.codex_sessions() if r["session_id"] in relayed]
            return {"ok": True, "codex": rows, "pid": os.getpid(), "started": self.started}
        if op == "peers":
            if not self.scanned.wait(90):
                self.scan()
            return {"ok": True, "peers": self.peers()}
        if op == "shutdown":
            self.stop_event.set()
            return {"ok": True}
        return {"ok": False, "error": f"unknown op {op!r}"}

    def reply_line(self, thread, raw):
        """A line on a Codex session's reply socket: a Claude session answering it."""
        self.last_activity = time.time()
        try:
            msg = json.loads(raw)
        except ValueError:
            log(f"reply socket of codex {thread}: a line that is not JSON, dropped")
            return
        kind = msg.get("type")
        if kind == "auth":
            return
        if kind == "control":
            self.notice_from_claude(thread, msg)
            return
        if kind != "user":
            log(f"reply socket of codex {thread}: a {kind!r} line, dropped")
            return
        content = (msg.get("message") or {}).get("content") or ""
        if not isinstance(content, str):     # content blocks, should a sender ever use them
            content = "".join(b.get("text", "") for b in content if isinstance(b, dict))
        messages = (parse_envelopes(content)
                    or [{"from": msg.get("from", ""), "from_name": "", "text": content}])
        self.inbound({"thread": thread, "messages": messages})

    def notice_from_claude(self, thread, msg):
        """Claude's word on a message it has not delivered, passed on to the Codex session.

        A receipt names the session that sends it (from) and says why (status,
        reason), not which message (2.1.283). Claude Code sends one only to a
        reply address named after the sending process's pid in its own socket
        directory, which no reply socket here is (2026-10-12): this is for the
        day that changes.
        """
        status = msg.get("status")
        log(f"reply socket of codex {thread}: {msg.get('action')} {status!r} from {msg.get('from')!r}")
        if msg.get("action") != "peer_message_status" or status in (None, "delivered"):
            return
        who = self.claude_name(msg.get("from") or "") or "a Claude session"
        words = {"held": "holds your message for its user's approval", "refused": "refused your message",
                 "expired": "dropped your message, its user not having approved it in time",
                 "dropped": "dropped your message"}
        ok, detail = deliver_to_codex(thread, f"agent-bridge: {who} {words.get(status, status)}.")
        if not ok:
            log(f"notice to codex {thread} not queued: {detail}")

    def inbound(self, req):
        """Claude -> Codex: what arrived on a Codex session's reply socket."""
        thread = req.get("thread", "")
        for msg in req.get("messages", []):
            src = msg.get("from_name") or msg.get("from") or "unknown session"
            if not self.allowed(src, thread):
                log(f"rate limit: dropped a message from {src!r} to {thread}")
                continue
            self.deliveries.put({"thread": thread, "msg": msg})
        return {"ok": True}

    def notify_claude(self, thread, address, text):
        """A word from the bridge to a Claude session about its message to a Codex session.

        It comes from that Codex session's reply socket, so an answer to it
        goes to the Codex session.
        """
        rec = next((r for r in self.claude_sessions() if f"uds:{r.get('inbox')}" == address), None)
        if not rec or not self.open_reply(thread):
            log(f"notice to {address!r} not sent: no such Claude session, or no reply socket")
            return
        try:
            post_to_claude(rec["inbox"], reply_socket(thread), "agent-bridge", text)
        except (OSError, ValueError) as exc:
            log(f"notice to {address!r} not sent: {exc}")

    def delivery_worker(self):
        while not self.stop_event.is_set():
            try:
                item = self.deliveries.get(timeout=1)
            except queue.Empty:
                continue
            thread, msg = item["thread"], item["msg"]
            reply_to = msg.get("from") or msg.get("from_name") or ""
            name = msg.get("from_name") or msg.get("from") or "an unidentified session"
            text = msg["text"] if reply_to else f"[sender not identified]\n{msg['text']}"
            ok, detail = deliver_to_codex(thread, codex_message(name, reply_to or name, text))
            log(f"to codex {thread} from {name!r}: {'queued' if ok else 'FAILED ' + detail}")
            if not reply_to.startswith("uds:"):
                continue         # nobody to tell
            if not ok:
                # Told the way an undeliverable message is told
                self.notify_claude(thread, reply_to, f"agent-bridge: your message to {self.name_of(thread)}"
                                                     f" was not delivered: {detail}")
                continue
            held = self.held_since(thread)
            if held and self.held_told.get((reply_to, thread)) != held:
                self.held_told[(reply_to, thread)] = held
                self.notify_claude(thread, reply_to,
                                   f"agent-bridge: your message to {self.name_of(thread)} is queued, but"
                                   " its last turn was interrupted: it reads queued messages only after"
                                   " its next typed one")

    def post(self, thread, rec, text):
        """A Codex session's message, written into a Claude session's inbox; send's answer."""
        to = rec.get("name") or rec["session_id"][:8]
        if not self.open_reply(thread):
            return {"ok": False, "error": f"this Codex session has no reply socket; see {LOG}"}
        # The session's own record, now: its id changes with a /clear, and the
        # transcript the message lands in with it
        registry = claude_registry(rec.get("pid"))
        target = {**rec, "session_id": registry.get("sessionId") or rec["session_id"]}
        transcript = claude_transcript(target["session_id"])
        try:
            offset = transcript.stat().st_size if transcript else 0
        except OSError:
            transcript, offset = None, 0
        try:
            msg_id = post_to_claude(registry.get("messagingSocketPath") or rec["inbox"],
                                    reply_socket(thread), self.name_of(thread), text)
        except ValueError as exc:
            return {"ok": False, "error": f"too long: {exc}"}
        except OSError as exc:
            return {"ok": False, "error": f"{to} takes no messages ({exc}); has it exited?"}
        state = confirm_delivery(target, transcript, offset, msg_id)
        if state == "unconfirmed":
            version = registry.get("version") or "?"
            detail = (f"not confirmed: {to} is idle and holds nothing, but has not taken it - its"
                      f" Claude Code ({version}) may read its inbox differently now")
            log(f"WARNING codex {thread} -> claude {to!r}: {detail} (msg_id {msg_id})")
        else:
            detail = {"delivered": "delivered",
                      "busy": "queued: it is busy, and reads it at its next tool call",
                      "waiting": "queued: it is waiting for its user",
                      "held": "held: its permission mode keeps messages from other sessions for"
                              " its user's approval"}[state]
            log(f"codex {thread} -> claude {to!r}: {detail}")
        return {"ok": True, "to": to, "detail": detail, "unconfirmed": state == "unconfirmed"}

    def send(self, req):
        """`agent-bridge send` from a Codex or a Claude session's shell.

        Anything to a Codex session goes into `codex queue`. A Codex session's
        message to a Claude session is written into that session's inbox, from
        the Codex session's reply socket. A Claude session reaching another
        Claude session needs nothing from here - SendMessage does it - so it is
        told the address to use instead.
        """
        sender, target, text = req.get("from") or {}, (req.get("to") or "").strip(), req.get("text", "")
        if not target or not text:
            return {"ok": False, "error": "need --to and a message"}
        agent, src = sender.get("agent"), sender.get("id", "")
        pool = self.codex_sessions if agent == "codex" else self.claude_sessions

        def is_sender(r):
            if agent == "claude" and sender.get("socket"):
                return r.get("inbox") == sender["socket"]
            return r["session_id"] == src

        if not any(is_sender(r) for r in pool()):
            self.scan()
        rec = next((r for r in pool() if is_sender(r)), None)
        if not rec:
            return {"ok": False, "error": f"no live {agent} session {src or sender.get('socket')} on this host"}
        src = rec["session_id"]
        if agent == "codex":
            src_name = reply_to = self.name_of(src)
            own = f"uds:{reply_socket(src)}"
        else:
            src_name = rec.get("name") or src[:8]
            own = f"uds:{sender.get('socket') or rec.get('inbox')}"
            reply_to = own
        try:
            kind, dst = self.resolve(target)
        except LookupError as exc:
            return {"ok": False, "error": str(exc)}
        if dst in (src, own):
            return {"ok": False, "error": "that is this session itself"}
        if not self.allowed(src, dst):
            return {"ok": False, "error": f"too many messages to {target} in the last {RATE_LIMIT[1]} s"}
        if kind == "codex":
            ok, detail = deliver_to_codex(dst, codex_message(src_name, reply_to, text))
            log(f"{agent} {src} -> codex {dst}: {'queued' if ok else 'FAILED ' + detail}")
            return {"ok": ok, "detail": detail, "to": self.name_of(dst),
                    "held": bool(ok and self.held_since(dst))}
        if agent == "claude":
            return {"ok": False, "use_sendmessage": dst,
                    "error": f"from a Claude session, reach a Claude session with SendMessage, to={dst!r}"}
        try:
            claude = self.claude_target(dst)
        except LookupError as exc:
            return {"ok": False, "error": str(exc)}
        return self.post(src, claude, text)

    def peers(self):
        rows = []
        for rec in self.sessions:
            if not rec.get("alive") or rec.get("kind") not in ("", "interactive", None):
                continue
            if rec["agent"] == "codex":
                thread = rec["session_id"]
                rows.append({"name": self.name_of(thread), "agent": "codex", "where": where_of(rec),
                             "reachable": "empty" if rec.get("empty") else "yes",
                             "session_id": thread, "cwd": rec.get("cwd", "")})
            else:
                rows.append({"name": rec.get("name") or rec["session_id"][:8], "agent": "claude",
                             "where": where_of(rec),
                             "reachable": "yes" if rec.get("inbox") else "no",
                             "session_id": rec["session_id"], "cwd": rec.get("cwd", "")})
        return rows

    def run(self):
        secure_run_dir()
        # Started from whichever session asked first: none of that session's
        # identity may leak into the codex and jcl runs made on everyone's behalf
        for key in list(os.environ):
            if key.startswith("CLAUDE_CODE_") or key in (
                    "CLAUDECODE", "CODEX_THREAD_ID", "CODEX_SESSION_ID", "TMUX", "TMUX_PANE",
                    "AGENT_BRIDGE_PROG"):
                del os.environ[key]
        lock = open(RUN_DIR / "daemon.lock", "w")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0      # another daemon is already up
        if SOCKET.exists():
            SOCKET.unlink()
        daemon = self

        class Handler(socketserver.StreamRequestHandler):
            def handle(self):
                try:
                    req = json.loads(self.rfile.readline() or b"{}")
                    resp = daemon.handle(req)
                except Exception as exc:          # one bad request must not kill the daemon
                    log(f"request failed: {exc!r}")
                    resp = {"ok": False, "error": str(exc)}
                self.wfile.write((json.dumps(resp) + "\n").encode())

        class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
            daemon_threads = True

        server = Server(str(SOCKET), Handler)
        os.chmod(SOCKET, 0o600)
        threading.Thread(target=server.serve_forever, daemon=True).start()
        threading.Thread(target=self.delivery_worker, daemon=True).start()
        signal.signal(signal.SIGTERM, lambda *_: self.stop_event.set())
        log(f"daemon {os.getpid()} up")
        try:
            while not self.stop_event.is_set():
                self.scan()
                turn_logs()
                with self.lock:
                    idle = not self.replies
                if idle and time.time() - self.last_activity > IDLE_EXIT:
                    log("no Codex session to relay for, leaving")
                    break
                self.stop_event.wait(SCAN_EVERY)
        finally:
            server.shutdown()
            with self.lock:
                threads = list(self.replies)
            for thread in threads:
                self.close_reply(thread)
            SOCKET.unlink(missing_ok=True)
            log(f"daemon {os.getpid()} down")
        return 0


def cmd_daemon(args):
    return Daemon().run()


COLOURS = {
    "RESET": "\033[0m", "BOLD": "\033[1m", "GREY": "\033[90m",
    "RED": "\033[31m", "GREEN": "\033[32m", "BLUE": "\033[34m",
    "MAGENTA": "\033[35m", "CYAN": "\033[36m", "LIGHTYELLOW": "\033[93m",
}


def palette(stream=None):
    stream = stream if stream is not None else sys.stdout
    if not stream.isatty() or os.environ.get("NO_COLOR"):
        return {key: "" for key in COLOURS}
    return dict(COLOURS)


def agent_colour(agent, c):
    return c["MAGENTA"] if agent == "claude" else c["BLUE"]


def _dwidth(text):
    """Columns the text occupies on screen, not characters it is made of.

    A CJK name such as "PSF 全局 ICM 管理功能" is 15 characters but 21 columns
    wide; padded with len(), it pushed the rest of its row six columns right.
    """
    return sum(2 if unicodedata.east_asian_width(ch) in "WF" else 1 for ch in text)


def _dljust(text, width):
    return text + " " * max(0, width - _dwidth(text))


def _ago(at, suffix=" ago"):
    """Coarse on purpose: one unit is all a column scanned by eye needs."""
    if not at:
        return "-"
    secs = max(0, time.time() - at)
    if secs < 60:
        return "now"
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if secs >= size:
            return f"{int(secs // size)}{unit}{suffix}"


def _tmux_cell(where):
    # app: Codex Desktop's or an IDE's own session, as jcl list marks it
    return "app" if where == "desktop" else where or "-"


def _cell_colour(column, value, c):
    """jcl list's colours, for the columns peers shares with it."""
    if column == "AGENT":
        return agent_colour(value, c)
    if column == "NAME":  # left plain so it stands out against the rest
        return ""
    return c["GREY"]  # SESSION ID


def _many(n, noun):
    return f"{n} {noun}" if n == 1 else f"{n} {noun}s"


def _table(headers, rows, c, right=()):
    """Print rows as `jcl list` prints its table.

    A bold header with one unbroken grey line under it, and no line closing
    the table: the caller leaves a blank line before its summary. Every cell
    is padded by the columns it takes on screen - the columns in right, which
    hold numbers, to the right - and coloured as jcl colours that column.
    """
    # Widths come from the plain text; colour is wrapped on afterwards, or the
    # escape codes would be counted as visible characters and break the columns.
    widths = [max(_dwidth(h), *(_dwidth(row[i]) for row in rows)) for i, h in enumerate(headers)]

    def justify(column, text, width):
        return " " * (width - _dwidth(text)) + text if column in right else _dljust(text, width)

    print(c["BOLD"] + "  ".join(justify(h, h, w) for h, w in zip(headers, widths)) + c["RESET"])
    print(c["GREY"] + "─" * (sum(widths) + 2 * (len(widths) - 1)) + c["RESET"])
    for row in rows:
        cells = []
        for column, cell, w in zip(headers, row, widths):
            colour = _cell_colour(column, cell, c)
            padded = justify(column, cell, w)
            # No reset without a colour to reset: NAME is left deliberately
            # plain, and a bare reset there is just noise in the output.
            cells.append(colour + padded + c["RESET"] if colour else padded)
        print("  ".join(cells))


def daemon_down(e):
    print(f"{e['RED']}agent-bridge daemon did not start{e['RESET']}; see {LOG}", file=sys.stderr)
    return 1


def cmd_start(args):
    c, e = palette(), palette(sys.stderr)
    try:
        pid = request({"op": "status"}, timeout=10).get("pid")
        print(f"{c['GREY']}agent-bridge daemon {pid} is already running, log {LOG}{c['RESET']}")
        return 0
    except (OSError, ValueError):
        pass
    if not ensure_daemon():
        return daemon_down(e)
    pid = request({"op": "status"}).get("pid")
    print(f"{c['GREEN']}Started{c['RESET']} agent-bridge daemon {pid}, log {LOG}")
    return 0


def caller(env=os.environ):
    """Who is running this: a Codex or a Claude session, by what its shell carries.

    A Claude session by its inbox, CLAUDE_CODE_MESSAGING_SOCKET, which Claude
    Code documents for scripts; CLAUDE_CODE_SESSION_ID, which it does not, is
    the fallback.
    """
    if env.get("CODEX_THREAD_ID"):
        return {"agent": "codex", "id": env["CODEX_THREAD_ID"]}
    if env.get("CLAUDE_CODE_MESSAGING_SOCKET") or env.get("CLAUDE_CODE_SESSION_ID"):
        return {"agent": "claude", "id": env.get("CLAUDE_CODE_SESSION_ID", ""),
                "socket": env.get("CLAUDE_CODE_MESSAGING_SOCKET", "")}
    return None


def cmd_send(args):
    c, e = palette(), palette(sys.stderr)
    sender = caller()
    if not sender:
        # A message goes out as the session whose shell sends it: a terminal
        # has none to send as, and must not pass for Peter typing either
        print(f"{e['RED']}agent-bridge send runs from a Codex or a Claude Code session{e['RESET']}"
              " (none of CODEX_THREAD_ID, CLAUDE_CODE_MESSAGING_SOCKET and CLAUDE_CODE_SESSION_ID"
              " is set).", file=sys.stderr)
        print(f"{e['GREY']}From a terminal, type into the session itself.{e['RESET']}", file=sys.stderr)
        return 2
    text = " ".join(args.message) if args.message else sys.stdin.read()
    if not ensure_daemon():
        return daemon_down(e)
    try:
        resp = request({"op": "send", "from": sender, "to": args.to, "text": text},
                       timeout=SEND_TIMEOUT)
    except (OSError, ValueError) as exc:
        print(f"{e['RED']}Not sent{e['RESET']}: {exc}", file=sys.stderr)
        return 1
    if resp.get("ok"):
        detail = f"{c['GREY']} ({resp['detail']}){c['RESET']}" if resp.get("detail") else ""
        # Written into its inbox but not seen taken: worth a look, not a resend
        sent = c["LIGHTYELLOW"] if resp.get("unconfirmed") else c["GREEN"]
        print(f"{sent}Sent{c['RESET']} to {resp.get('to') or args.to}{detail}")
        if resp.get("held"):
            print(f"{c['LIGHTYELLOW']}Held{c['RESET']}: its last turn was interrupted, so it reads"
                  " queued messages only after its next typed one")
        return 0
    if resp.get("use_sendmessage"):
        # Not a failure to report as one: the address is the answer
        print(f"{c['LIGHTYELLOW']}Use SendMessage{c['RESET']} with to={resp['use_sendmessage']!r}"
              " (a Claude session reaches another Claude session natively)")
        return 3
    print(f"{e['RED']}Not sent{e['RESET']}: {resp.get('error') or resp.get('detail')}", file=sys.stderr)
    return 1


def cmd_peers(args):
    c, e = palette(), palette(sys.stderr)
    if not ensure_daemon():
        return daemon_down(e)
    peers = request({"op": "peers"}, timeout=90).get("peers", [])
    if args.json:
        print(json.dumps(peers, indent=2, ensure_ascii=False))
        return 0
    if not peers:
        print(f"{e['RED']}No session to message on this host.{e['RESET']}", file=sys.stderr)
        return 1
    # An address book, not a second jcl list: what --to takes. Where a session
    # runs and on what is jcl list's to show (they were columns here once, and
    # the table read as a copy of it). A name stays whole, being what a sender
    # copies. A REACHABLE column read yes on every row; the rare session a
    # message cannot reach is named in the summary instead (2026-10-12).
    headers = ("NAME", "AGENT", "SESSION ID")
    rows = [(p["name"] or "", p["agent"], p["session_id"]) for p in peers]
    _table(headers, rows, c)
    print()
    agents = collections.Counter(p["agent"] for p in peers)
    parts = [f"{c['BOLD']}{len(peers)}{c['RESET']} {'session' if len(peers) == 1 else 'sessions'}"]
    parts += [f"{n} {agent_colour(a, c)}{a}{c['RESET']}" for a, n in sorted(agents.items())]
    why = {"empty": "no message yet", "no": "no inbox"}
    unreachable = [f"{p['name'] or p['session_id'][:8]} ({why.get(p['reachable'], p['reachable'])})"
                   for p in peers if p["reachable"] != "yes"]
    if unreachable:
        parts.append(f"{c['LIGHTYELLOW']}not reachable{c['RESET']}: " + ", ".join(unreachable))
    print(" · ".join(parts))
    return 0


def cmd_status(args):
    c, e = palette(), palette(sys.stderr)
    try:
        resp = request({"op": "status"}, timeout=10)
    except (OSError, ValueError):
        # A state, not an error: said where the rest of status is said
        print(f"agent-bridge is {c['LIGHTYELLOW']}not running{c['RESET']}:"
              " Claude and Codex sessions cannot message each other.")
        print(f"{c['GREY']}Start it with: {PROG} start{c['RESET']}")
        return 1
    print(f"{c['GREY']}Daemon {resp.get('pid')}, up {_ago(resp.get('started'), '')},"
          f" log {LOG}{c['RESET']}")
    codex = resp.get("codex", [])
    if not codex:
        print(f"{c['GREY']}No Codex session to relay for: none is live, or none has had a"
              f" first message.{c['RESET']}")
        return 0
    # The Codex sessions it relays for, by name and where they are. A table of
    # them, with per-session counts reset by every restart, said no more than
    # jcl list does (2026-10-12)
    names = ", ".join(f"{s['name'] or s['thread'][:8]} ({_tmux_cell(s.get('where'))})" for s in codex)
    print(f"Relaying for {c['BLUE']}{_many(len(codex), 'Codex session')}{c['RESET']}: {names}")
    return 0


def cmd_restart(args):
    rc = cmd_stop(args) or cmd_start(args)
    if rc:
        return rc
    # The new daemon scans at once and a scan request waits behind that scan:
    # status after it lists every Codex session's reply socket, not none yet
    request({"op": "scan"}, timeout=120)
    return cmd_status(args)


def cmd_stop(args):
    c, e = palette(), palette(sys.stderr)
    try:
        request({"op": "shutdown"})
    except (OSError, ValueError):
        print(f"{c['GREY']}agent-bridge daemon is not running.{c['RESET']}")
        return 0
    # It closes its reply sockets before it removes its own socket, so that
    # one going is what says it has finished
    deadline = time.monotonic() + 60
    while SOCKET.exists() and time.monotonic() < deadline:
        time.sleep(0.5)
    if SOCKET.exists():
        print(f"{e['RED']}agent-bridge daemon is still stopping{e['RESET']}; see {LOG}", file=sys.stderr)
        return 1
    print(f"{c['GREEN']}Stopped{c['RESET']} the agent-bridge daemon")
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Let Claude Code and Codex sessions on this host message each other.",
    )
    # daemon is agent-bridge's own, run by itself: left out of the list help
    # shows, and of the completion. So is send under jcl bridge, which refuses
    # it: a person asks a session to send instead.
    by_agents = PROG == "agent-bridge"
    sub = parser.add_subparsers(
        dest="command",
        metavar=("{send,peers,status,start,stop,restart}" if by_agents
                 else "{peers,status,start,stop,restart}"))

    # No help= at all hides a command: argparse 3.10 prints SUPPRESS as is
    p_send = sub.add_parser(
        "send", **({"help": "Send a message to a session by name or session id"} if by_agents else {}),
        description=(
            "Send a message to another Claude Code or Codex session on this host. Run"
            " it from the shell of a Codex or Claude Code session: the message goes out"
            " as that session (CODEX_THREAD_ID or CLAUDE_CODE_SESSION_ID says which) and"
            " arrives as \"Message from @<its name>\". A Codex session gets it queued in;"
            " a Claude session gets it written into its inbox, as SendMessage delivers,"
            " and answers it with SendMessage to the uds: address it came from. Codex"
            " sessions are not in Claude's /list-agents: this is how a Claude session"
            " reaches one. Between two Claude sessions nothing needs relaying: the"
            " address to give SendMessage is printed instead, with exit status 3. From a"
            " plain terminal it refuses, with exit status 2."
        ),
    )
    p_send.add_argument(
        "--to",
        required=True,
        metavar="SESSION",
        help="A session's name or session id (8+ leading characters will do), as"
             " `jcl list` and `agent-bridge peers` show them, or the uds: address a"
             " message came from",
    )
    p_send.add_argument("message", nargs="*", help="Message text (stdin when omitted)")
    p_send.set_defaults(func=cmd_send)

    p_peers = sub.add_parser(
        "peers", help="Show the sessions that can be messaged",
        description=(
            "Show the Claude Code and Codex sessions on this host that can be messaged,"
            " under the names and session ids `send --to` takes. One a message cannot"
            " reach is named in the summary: a Codex session that has had no message"
            " yet, which nothing can queue into, or a Claude session with no messaging"
            " socket. Where a session runs and on what: `jcl list`. Starts the daemon"
            " unless it is running."
        ),
    )
    p_peers.add_argument("--json", action="store_true", help="Emit JSON")
    p_peers.set_defaults(func=cmd_peers)

    p_status = sub.add_parser(
        "status", help="Show the daemon and the Codex sessions it relays for",
        description=(
            "Show whether the daemon runs, its log, and the Codex sessions it relays for -"
            " each live one that has had a first message - by name and tmux pane (app for"
            " Codex Desktop's own). Starts nothing. What `agent-bridge` alone runs."
        ),
    )
    p_status.set_defaults(func=cmd_status)

    p_start = sub.add_parser(
        "start", help="Start the daemon unless it is running",
        description=(
            "Start the daemon unless it is running; a running one is left as it is."
            " An agent's send or peers starts it too, so this is for bringing it"
            " back after a stop. It leaves by itself after"
            f" {IDLE_EXIT // 60} minutes with no Codex session to relay for and no request."
        ),
    )
    p_start.set_defaults(func=cmd_start)

    p_stop = sub.add_parser(
        "stop", help="Stop the daemon",
        description=(
            "Stop the daemon. Until start - or an agent's send or peers - brings it"
            " back, a Claude session's reply to a Codex session's uds: address is not"
            " delivered."
        ),
    )
    p_stop.set_defaults(func=cmd_stop)

    p_restart = sub.add_parser(
        "restart", help="Stop and start the daemon, then show status",
        description=(
            "Stop the daemon, start it again, and show status - after an update of"
            " agent-bridge, or when it misbehaves. Each Codex session's uds: address"
            " stays the same: a reply sent to one afterwards still arrives."
        ),
    )
    p_restart.set_defaults(func=cmd_restart)

    p_daemon = sub.add_parser("daemon")
    p_daemon.set_defaults(func=cmd_daemon)

    args = parser.parse_args(argv)
    if not args.command:
        args = parser.parse_args(["status"])
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
