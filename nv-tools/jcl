            " then offered a token borrowed from a server that shares its gateway, the"
            " way fill-auth does, so restoring is one command rather than a choice"
            " between two. The merge happens at the mcpOAuth key, so an Anthropic"
            " account login living in the same file is left alone. Run"
            " `jcl refresh` afterwards - a live process keeps the"
            " credentials it read at startup, and it can rewrite this file from memory."
        ),
    )
    p_restore_auth.add_argument(
        "-f",
        "--file",
        default=str(DEFAULT_AUTH_BACKUP),
        help=f"Backup to restore from (default: {DEFAULT_AUTH_BACKUP})",
    )
    p_restore_auth.add_argument(
        "--force", action="store_true", help="Overwrite entries that already hold a token"
    )
    p_restore_auth.add_argument(
        "--no-fill",
        action="store_true",
        help="Skip the borrowing pass, restore from the backup only",
    )
    p_restore_auth.add_argument(
        "-n", "--dry-run", action="store_true", help="Print the merge, write nothing"
    )
    p_restore_auth.set_defaults(func=cmd_restore_auth)

    p_fill_auth = sub.add_parser(
        "fill-auth",
        help="Copy a working token onto MCP servers that have none",
        description=(
            "Servers sharing a gateway often accept each other's tokens, but no stored"
            " field says which ones do. Each authenticated server's token is offered to"
            " each empty server against its own URL with an MCP initialize call, and"
            " copied only where the gateway answers. So a set of servers behind one"
            " gateway costs a single interactive authorization instead of one each."
            " restore-auth runs this as its second pass, so reach for it on its own"
            " after adding a server, or when there is no backup to restore from."
        ),
    )
    p_fill_auth.add_argument(
        "-n", "--dry-run", action="store_true", help="Probe and report, write nothing"
    )
    p_fill_auth.set_defaults(func=cmd_fill_auth)

    args = parser.parse_args(argv)
    if not args.command:
        args = parser.parse_args(["list"])
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
