#!/usr/bin/env bash
# shellcheck disable=SC1091
# set -x

# Global Variables
fQuery=
fRgOnly=
fEditor="code"
# fEditor="jrcode"
fCheckDepends=
fzfSelected=
fREMatching=
fExactMatching=
fFuzzyFallback=
fRgPattern=
fRgLiteral=
fNoClipboard=
fXselTimeout=10
fQueryFromClipboard=
fAllFiles=        # Search all files (ignore type filters)
# Constants
SCRIPTNAME=$(basename $0)
# Cache uname result to avoid repeated calls
OS_TYPE=$(uname)
# Colors
MAGENTA='\033[35m'
CYAN='\033[36m'
LIGHTYELLOW='\033[1;33m'
BOLD='\033[1m'
BLUE='\033[34m'
RESET='\033[0m'
COLOR=$MAGENTA
USER_NOTATION="${CYAN}▸${RESET}"

usage() {
    cat << _EOF
Usage: $SCRIPTNAME [OPTIONS] [SEARCH_TERM]

This script requires the following dependencies:
- rg (ripgrep)
- fzf (fuzzy finder)
- bat (cat replacement)
- xsel (clipboard manager, Linux with X11) or pbpaste/pbcopy (macOS)
- code/vim

Run this script with the --check-depends option to check if these dependencies are installed.

Clipboard support:
- macOS (local): Uses pbpaste/pbcopy natively
- macOS -> Linux (SSH): Use XQuartz with X11 forwarding (ssh -X) for xsel support
- Windows -> Linux (SSH): Use XLaunch/VcXsrv with X11 forwarding for xsel support

Options:
    -h, --help               Print this help message
    -d, --debug              Print debug information
    -v, --vim                Open the file with vim (default is $fEditor)
    -c, --check-depends      Check if dependencies are installed
    -n, --no-clipboard       Do not use clipboard content as the search term
    -A, --all-files          Search all files (ignore type filters)
    -e, --exact              Force literal substring filtering inside fzf
    --rg-only                Only use rg to search, not use fzf to select
    --re-matching            Force regular expression matching in rg

Matching behaviour:
    fzf always filters fuzzily, so typing 'nvmemanager' narrows down to
    'IsNvmeEmuManager'. rg searches literally first; when a literal search finds
    nothing, it retries with a subsequence pattern so those camelCase hits still
    reach fzf.

Example: $SCRIPTNAME wad_tcp_bind
         $SCRIPTNAME nvmemanager

_EOF
    exit 0
}

parseOptions() {
    # Define short and long options
    # Detect and use GNU getopt if available (required for long options on macOS)
    local GETOPT_BIN="getopt"
    if command -v /opt/homebrew/opt/gnu-getopt/bin/getopt &> /dev/null; then
        GETOPT_BIN="/opt/homebrew/opt/gnu-getopt/bin/getopt"
    elif command -v /usr/local/opt/gnu-getopt/bin/getopt &> /dev/null; then
        GETOPT_BIN="/usr/local/opt/gnu-getopt/bin/getopt"
    fi

    SHORTOPTS="hvdcnAe"
    LONGOPTS="help,vim,debug,rg-only,check-depends,no-clipboard,re-matching,exact,all-files"

    # Use getopt to parse command-line options
    if ! PARSED=$("$GETOPT_BIN" --options $SHORTOPTS --longoptions "$LONGOPTS" --name "$0" -- "$@"); then
        echo -e "$USER_NOTATION ${COLOR}Error: Failed to parse command-line options.${RESET}" >&2
        exit 1
    fi

    # Reset positional parameters to the parsed values
    eval set -- "$PARSED"

    # Parse options
    while true; do
        case "$1" in
            -h|--help)
                usage
                ;;
            -v|--vim)
                fEditor="vim"
                shift
                ;;
            -d|--debug)
                set -x
                shift
                ;;
            -c|--check-depends)
                fCheckDepends=true
                shift
                ;;
            -n|--no-clipboard)
                fNoClipboard=true
                shift
                ;;
            --re-matching)
                fREMatching=true
                shift
                ;;
            -e|--exact)
                fExactMatching=true
                shift
                ;;
            -A|--all-files)
                fAllFiles=true
                shift
                ;;
            --rg-only)
                fRgOnly=true
                shift
                ;;
            --)
                shift
                break
                ;;
            *)
                echo -e "$USER_NOTATION ${COLOR}Invalid option: $1${RESET}"
                exit 1
                ;;
        esac
    done

    fQuery="$*"
}

checkDepends() {
    local missingDeps=()
    local depends=("rg" "fzf" "bat" "$fEditor")
    local depStatus
    local depVersion

    # Add OS-specific clipboard dependency
    if [[ "$OS_TYPE" == "Darwin" ]]; then
        depends+=("pbpaste" "pbcopy")
    else
        depends+=("xsel")
    fi

    echo -e "${COLOR}Checking dependencies...${RESET}"

    for dep in "${depends[@]}"; do
        if command -v "$dep" &>/dev/null; then
            depStatus="${BLUE}[FOUND]${RESET}"
            # Try to get version, handle errors gracefully
            # pbpaste/pbcopy don't support --version
            if [[ "$dep" == "pbpaste" || "$dep" == "pbcopy" ]]; then
                depVersion="(macOS built-in)"
            else
                depVersion=$($dep --version 2>&1 | head -n 1)
                if [[ $? -ne 0 || -z "$depVersion" ]]; then
                    depVersion="Version info unavailable"
                fi
            fi
            echo -e "$dep: $depStatus $depVersion"
        else
            depStatus="${LIGHTYELLOW}[MISSING]${RESET}"
            echo -e "$dep: $depStatus"
            missingDeps+=("$dep")
        fi
    done

    if [[ ${#missingDeps[@]} -gt 0 ]]; then
        echo -e "\n${COLOR}Error: The following dependencies are missing or not found in PATH:${RESET}"
        for missing_dep in "${missingDeps[@]}"; do
            echo -e "  - ${BOLD}$missing_dep${RESET}"
        done
        echo -e "${COLOR}Please install them to proceed.${RESET}"
        exit 1
    fi

    echo -e "\n${COLOR}All dependencies are satisfied.${RESET}"
    exit 0
}

# Clipboard notes:
#
# macOS:
#   - Uses pbpaste/pbcopy for clipboard access
#   - Single unified clipboard (like Windows)
#
# X11 (Linux with X server):
#   There are three primary selections (clipboard buffers):
#   1. PRIMARY
#      - Default selection in X11
#      - Used for middle-click paste (Shift+Insert in terminals)
#      - Example: Highlighting text automatically copies it to PRIMARY
#   2. CLIPBOARD
#      - Behaves like the traditional clipboard (Ctrl+C / Ctrl+V)
#      - Used by most GUI applications (e.g., Firefox, LibreOffice)
#   3. SECONDARY
#      - Rarely used, mainly for legacy applications
GetClipboardContent() {
    if [ -z "$fQuery" ]; then
        if [[ "$OS_TYPE" == "Darwin" ]]; then
            # macOS - use pbpaste (unified clipboard)
            fQuery=$(pbpaste 2>/dev/null)
            if [[ $? -ne 0 ]]; then
                echo -e "${COLOR}Error: Failed to get clipboard content using pbpaste.${RESET}"
                exit 1
            fi
            [ -n "$fQuery" ] && fQueryFromClipboard=true
        elif [ -n "$DISPLAY" ]; then
            # Linux with X11 - try CLIPBOARD first (Cmd+C on Mac), then PRIMARY (selection)
            fQuery=$(timeout $fXselTimeout xsel -o -b 2>/dev/null)
            if [[ -z "$fQuery" ]]; then
                # Fallback to PRIMARY selection
                fQuery=$(timeout $fXselTimeout xsel -o -p 2>/dev/null)
            fi
            [ -n "$fQuery" ] && fQueryFromClipboard=true
        elif [ -n "$SSH_CONNECTION" ]; then
            # SSH session without X11 forwarding - provide helpful message
            echo -e "${COLOR}No clipboard access (SSH without X11 forwarding).${RESET}"
            echo -e "${COLOR}Options:${RESET}"
            echo -e "  1. Pass search term as argument: ${BOLD}jr \"search_term\"${RESET}"
            echo -e "  2. Use X11 forwarding: ${BOLD}ssh -X${RESET} (requires XQuartz on Mac)"
            exit 1
        fi
    fi
}

# Runs from an EXIT trap, so a failure here only warns: overriding the exit code
# would misreport the outcome of the search itself.
ClearClipboard() {
    if [ -n "$fQueryFromClipboard" ]; then
        if [[ "$OS_TYPE" == "Darwin" ]]; then
            # macOS - clear clipboard by writing empty string
            if ! echo -n "" | pbcopy 2>/dev/null; then
                echo -e "${COLOR}Warning: Failed to clear clipboard content${RESET}" >&2
            fi
        elif [ -n "$DISPLAY" ]; then
            # Linux with X11 - use xsel
            if ! timeout $fXselTimeout xsel -c -p 2> /dev/null; then
                echo -e "${COLOR}Warning: Failed to clear PRIMARY clipboard content${RESET}" >&2
            fi
        fi
    fi
}

polishQuery() {
    [ -n "$fQueryFromClipboard" ] && fQuery="${fQuery:0:80}"
    fQuery="${fQuery%%$'\n'*}"
    # Trim leading/trailing whitespace
    fQuery="${fQuery#"${fQuery%%[![:space:]]*}"}"
    fQuery="${fQuery%"${fQuery##*[![:space:]]}"}"

    # Remove leading &!< characters if present
    [[ $fQuery =~ ^[\&!\<] ]] && fQuery="${fQuery:1}"
    # Remove func= prefix if present
    [[ $fQuery == func=* ]] && fQuery="${fQuery#func=}"
    # Remove trailing semicolon and > if present
    [[ $fQuery == *[\;\>] ]] && fQuery="${fQuery%?}"
    # Remove :[0-9]+ from the end if present
    [[ $fQuery =~ :[0-9]+$ ]] && fQuery="${fQuery%:*}"
}

# Turn a query into a regex matching its characters as a subsequence of a single
# word: nvmemanager -> n\w{0,2}v\w{0,2}m... An empty maxGap means unlimited.
buildFuzzyPattern() {
    local query="$1" maxGap="$2" gapExpr pattern='' i
    if [ -n "$maxGap" ]; then
        gapExpr="\\w{0,$maxGap}"
    else
        gapExpr="\\w*"
    fi
    for (( i = 0; i < ${#query}; i++ )); do
        [ $i -gt 0 ] && pattern+="$gapExpr"
        pattern+="${query:i:1}"
    done
    printf '%s' "$pattern"
}

# rg is the first filter of the pipeline, so fzf can only ever refine what rg
# already found: a literal search for 'nvmemanager' returns nothing and fzf never
# gets a chance to reach 'IsNvmeEmuManager'. When the literal search comes up
# empty, retry with subsequence patterns and keep the tightest one that still
# hits, since a wider gap pulls in far more unrelated lines.
# Takes the rg arguments assembled so far; sets fRgPattern and fRgLiteral.
resolveRgPattern() {
    local gap candidate
    fRgPattern="$fQuery"
    fRgLiteral=
    [ -n "$fQuery" ] && [ -z "$fREMatching" ] && fRgLiteral=true
    [ -z "$fRgLiteral" ] && return
    # Only plain identifiers are worth fuzzing; anything else is likely a literal
    # phrase or already carries punctuation that would need escaping.
    [[ $fQuery =~ ^[A-Za-z0-9_]{3,40}$ ]] || return
    rg --quiet "$@" --fixed-strings "$fQuery" 2> /dev/null && return

    for gap in 2 ""; do
        candidate=$(buildFuzzyPattern "$fQuery" "$gap")
        if rg --quiet "$@" "$candidate" 2> /dev/null; then
            fRgPattern="$candidate"
            fRgLiteral=
            fFuzzyFallback=true
            return
        fi
    done
}

# $fEditor may resolve to a shell function (see code-function.sh), which still
# works when invoked through a variable, so the path can be passed as a single
# quoted argument instead of being escaped by hand for eval.
openInEditor() {
    local filepath="$1" linenumber="$2"
    if [[ "$fEditor" == "vim" ]]; then
        vim "+$linenumber" "$filepath"
    else
        "$fEditor" "$filepath:$linenumber"
    fi
}

fuzzySearch() {
    # rg options:
    # --fixed-strings Treat the pattern as a literal string
    # '--glob' '*.{c,h,cpp,js,ts,py,html,css,sh,php}'
    # fzf needs the escape codes to colourise matches, but --rg-only output is
    # usually piped or redirected, where 'auto' drops them
    local colorMode="ansi"
    [ -n "$fRgOnly" ] && colorMode="auto"
    local rgParams=(
        "--smart-case"
        "--color=$colorMode"
        "--colors" "match:fg:204,51,153"
        "--colors" "match:style:bold"
        "--line-number"
        "--max-columns=200"
        "--max-columns-preview"
    )
    if [ -n "$fAllFiles" ]; then
        rgParams+=("--no-ignore")
    else
        rgParams+=(
            "--type" "c"
            "--type" "cpp"
            "--type" "py"
            "--type" "sh"
            "--type" "make"
            "--type" "asm"
            "--type-add" "linkerscript:*.ld,*.lds"
            "--type" "linkerscript"
            "--type-add" "adb:*.adb"
            "--type" "adb"
            "--type" "txt"
        )
    fi
    rgParams+=(
        # Exclude directories
        "--glob" "!.git/*"
        "--glob" "!node_modules/*"
        "--glob" "!vendor/*"
        "--glob" "!build/*"
        "--glob" "!bin/*"
        "--glob" "!fpx-sync/*"
        # Skip the linux kernel sources, they only slow the search down
        "--glob" "!linux-*/*"
    )
    # By default, fzf starts in extended-search mode, which allows multiple search terms separated by spaces
    # fzf options:
    # --exact: Forces exact matching
    #   requiring the query to appear literally in the input instead of allowing fuzzy matches.
    # --no-extended: Disables extended-search mode
    #   preventing the use of special syntax like ^, $, !, or space-separated terms for advanced queries.
    local fzfParams=(
        "--prompt=☞ "
        "--layout=reverse"
        "--inline-info"
        "--color=fg+:247"
        "--multi"
        "--style" "default"
        "--ansi"
        "--color" "hl:-1:underline,hl+:-1:underline:reverse"
        "--delimiter" ":"
        "--preview" "bat --color=always {1} --theme=TwoDark --highlight-line {2}"
        "--preview-window" "top,60%,border-bottom,+{2}+3/3,~3"
        "--cycle"
        "--exit-0"
    )

    # An empty query lists everything and lets fzf do all the filtering
    resolveRgPattern "${rgParams[@]}"
    [ -n "$fRgLiteral" ] && rgParams+=("--fixed-strings")
    rgParams+=("${fRgPattern:-.}")
    fzfParams+=("--query" "${fQuery}")
    [ -n "$fExactMatching" ] && fzfParams+=("--exact")
    [ -n "$fFuzzyFallback" ] && fzfParams+=("--header=fuzzy fallback: no literal match for '$fQuery'")

    if [ -n "$fRgOnly" ]; then
        [ -n "$fFuzzyFallback" ] &&
            echo -e "$USER_NOTATION ${COLOR}No literal match for '$fQuery', falling back to fuzzy matching${RESET}" >&2
        rg "${rgParams[@]}"
        exit 0
    fi

    # Unified search and selection
    fzfSelected=$(rg "${rgParams[@]}" | FZF_DEFAULT_OPTS="" fzf "${fzfParams[@]}")

    if [ -z "$fzfSelected" ]; then
        [ -n "$fQuery" ] && echo -e "No result found or selected for query: ${COLOR}$fQuery${RESET}" >&2
        exit 0
    fi

    # fzf runs with --multi, so every selected line has to be handled.
    # Sample output of fzfSelected:
    # daemon/wad/wad_app_eng.c:3071:          goto session_make_failed;
    # Z15 Bug 0996624 FTP fails active in TP mode/debug2_passive.c:398:CLNT lftp/4.9.2
    local line opened=0
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        if [[ $line =~ ^([^:]+):([0-9]+): ]]; then
            openInEditor "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
            opened=$((opened + 1))
            echo -e "Line opened: ${COLOR}${line:0:80}${RESET}"
        else
            echo -e "${COLOR}Skipped unexpected format: ${line:0:80}${RESET}" >&2
        fi
    done <<< "$fzfSelected"

    [ "$opened" -eq 0 ] && exit 1
    return 0
}

main() {
    # source the code function (only if file exists)
    # shellcheck source=/dev/null
    [[ -f "$HOME/Templates/code-function.sh" ]] && source "$HOME/Templates/code-function.sh"
    # Do the main work
    parseOptions "$@"
    [ -n "$fCheckDepends" ] && checkDepends
    # fuzzySearch exits early on several paths, so clean up from a trap
    if [ -z "$fNoClipboard" ]; then
        GetClipboardContent
        trap ClearClipboard EXIT
    fi
    [ -z "$fREMatching" ] && polishQuery
    fuzzySearch
}

main "$@"
